<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Defines the directory and name for your Selenium logs -->
        <Property name="basePath">./logs</Property>
        <Property name="logFileName">selenium-run</Property>
    </Properties>

    <Appenders>
        <!-- Console Appender for real-time IDE execution tracking -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- Rolling File Appender to save test history and prevent single massive files -->
        <RollingFile name="FileAppender" 
                     fileName="${basePath}/${logFileName}.log"
                     filePattern="${basePath}/${logFileName}-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Root Logger configuration capturing INFO level messages and above -->
        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Root>
    </Loggers>
</Configuration>
